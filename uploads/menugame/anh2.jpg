    <script>
        // config select 2
        let $select_2 = $('.select-2-custom');
        $select_2.select2({
            placeholder: '--Không chọn--',
            allowClear: true,
        });

        $('.select-2-custom-skin').append('<option selected></option>').select2({
            placeholder: '--Không chọn--',
            allowClear: true,
            multiple: true,
        });
        $('.reload-nick-random').on('click', function () {
            $('#successNickRandomPurchase').modal('hide');
        })
        $('.button__link_list').on('click', function () {
            const dataValue = $(this).data('value');
            const dataId = $(this).data('id');
            const dataType = $(this).data('type');
            $('.list-related-tag-home>a').removeClass('active');
            $(this).addClass('active')
            if (dataType == 'meta_attribute') {
                query['page'] = 1;
                query['select_data'] = dataId;
                query['title_data'] = null;
                query['price_data'] = null;
                query['status_data'] = null;
                query['sort_by_data'] = null;
            }
            if (dataType == 'price_find') {
                query['page'] = 1;
                query['select_data'] = null;
                query['title_data'] = null;
                query['price_data'] = dataValue;
                query['status_data'] = null;
                query['sort_by_data'] = null;
            }
            loadDataApi(query);
        });
    </script>

    
    
    
    
    
    
    

    
    
    
    
    
    
